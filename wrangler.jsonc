{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "call-center-game",
  "compatibility_date": "2026-09-04",
  // No Worker script - this is a static site. scripts/build-site.sh stages
  // dist/site with just the files the browser needs.
  "assets": {
    "directory": "./dist/site",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  }
}
